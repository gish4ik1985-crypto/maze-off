class_name CaveClaim
extends RefCounted

## §62 шаг 4, часть 3 (GAMEDESIGN.md): адресация владения территорией
## (_claim_time/Метка §52/Соглядатай §57/Очаг §59, main.gd) для графового
## этажа Пещер — ключ Vector2i(f, node_index) вместо Vector3i(f, cx, cy).
##
## ВАЖНО: логика распада (`claim_strength`, `ground_danger`, TTL-математика
## в main.gd) НЕ трогается и не нуждается в изменениях — она уже написана
## как функция от произвольного хэшируемого ключа и текущего времени
## (`_claim_time: Dictionary`, ключ → момент последнего подтверждения),
## а не от координат клетки как таковых. Единственное, что меняется для
## графового этажа, — САМ ключ: вместо клетки сетки берём ближайший узел
## графа. Поэтому здесь только функция построения ключа, не копия
## claim/decay-логики main.gd (копировать её было бы дублированием ровно
## того, что и так уже работает).
##
## Как и `cave_pursuer_path.gd`, этот файл НЕ подключён к `main.gd` —
## интеграция (реальный вызов `_claim(CaveClaim.claim_key(...))` вместо
## `_claim(Vector3i(f, c.x, c.y))` на графовых этажах) произойдёт на шаге 5,
## когда сам этаж станет графовым. До этого main.gd/`_claim_time`/Метка/
## Соглядатай/Очаг продолжают работать по клеточной сетке ВЕЗДЕ, включая
## текущий режим «Пещеры» (который до сих пор рисует сетку скруглённой,
## см. §60/§61) — их поведение не изменилось.

## Индекс ближайшего узла графа к мировой позиции pos. Возвращает -1, если
## nodes пуст. Линейный перебор — при реальной интеграции (десятки-сотни
## узлов на этаж, см. харнессы шагов 1-3) это дёшево; если понадобится
## чаще одного раза за кадр на игрока, можно кэшировать через
## пространственную решётку, но пока такой необходимости нет.
static func nearest_node(nodes: Array[Vector2], pos: Vector2) -> int:
	var best := -1
	var best_dist := INF
	for i in nodes.size():
		var d: float = nodes[i].distance_squared_to(pos)
		if d < best_dist:
			best_dist = d
			best = i
	return best

## Ключ владения для графового этажа — тот же тип (Vector2i), что и Vector3i
## в клеточной модели по факту хэшируется одинаково хорошо как ключ
## Dictionary; здесь f хранится в X, индекс узла — в Y (порядок неважен,
## главное — что ключи разных (f, node) не совпадают между собой).
static func claim_key(floor: int, node_index: int) -> Vector2i:
	return Vector2i(floor, node_index)

## Удобный шорткат: мировая позиция + этаж -> ключ владения на графовом
## этаже, одним вызовом (аналог `_world_to_cell` + `Vector3i(f,c.x,c.y)`
## в клеточной модели main.gd, см. `ground_danger_at`).
static func claim_key_at(nodes: Array[Vector2], floor: int, world_pos: Vector2) -> Vector2i:
	return claim_key(floor, nearest_node(nodes, world_pos))
