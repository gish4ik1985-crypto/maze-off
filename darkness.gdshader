shader_type canvas_item;

// Затемнение к краям экрана — «туман войны» вокруг игрока. Камера держит игрока
// в центре, поэтому экранная виньетка = шар видимости вокруг него. Прозрачно в
// центре, плавно к чёрному по краям. Обычное (mix) смешивание умножает кадр к
// чёрному. max_dark < 1 оставляет щель, сквозь которую пробивается яркий свет
// (сонар, выход, столпы залов), а тусклый ambient далёкого лабиринта гаснет.
//
// Радиус меряется в долях ПОЛУВЫСОТЫ: d = 1.0 на верхней/нижней кромке экрана.
//
// [GAMEDESIGN §45] Виньетка больше не круг. У игрока с самого начала был
// фонарь-конус (player._cone), но круглая виньетка срезала всё, что он
// освещал: направленный СВЕТ существовал, а направленной ВИДИМОСТИ не было.
// Теперь вдоль beam_dir шар вытягивается — видно дальше туда, куда смотришь, и
// хуже по сторонам. Свет стал тем, чем ты светишь, а не только тем, что тратишь.
uniform float inner : hint_range(0.0, 2.0) = 0.62;     // радиус полностью видимой зоны
uniform float outer : hint_range(0.0, 2.5) = 1.08;     // радиус полного затемнения
uniform float max_dark : hint_range(0.0, 1.0) = 0.82;  // максимум затемнения по краям
uniform float aspect = 1.777;
uniform vec2 center = vec2(0.5);                       // экранная позиция игрока (UV)

// Луч. reach = 0.0 полностью выключает механику и возвращает прежний круг —
// это и кнопка отката, и то, что происходит там, где луч не нужен.
uniform vec2 beam_dir = vec2(1.0, 0.0);                // куда смотрит игрок (мировые оси = экранные)
uniform float beam_reach : hint_range(0.0, 1.5) = 0.0; // насколько дальше видно вдоль луча
uniform float beam_focus : hint_range(0.0, 1.0) = 0.5; // ширина: больше — уже конус

void fragment() {
	vec2 p = (UV - center) * vec2(aspect, 1.0) * 2.0;  // p.y ∈ [-1,1] на кромках
	float d = length(p);

	// Угловой множитель: 1 строго вперёд, 0 по сторонам и назад. beam_dir тоже
	// умножается на aspect — иначе на широком экране луч уезжает вбок.
	float a = 0.0;
	if (beam_reach > 0.001 && d > 0.0001) {
		vec2 bd = normalize(vec2(beam_dir.x * aspect, beam_dir.y));
		float c = dot(p / d, bd);
		a = smoothstep(beam_focus, 1.0, c);
	}

	float inner_d = inner + beam_reach * a;
	float outer_d = outer + beam_reach * a * 1.3;
	float v = smoothstep(inner_d, outer_d, d) * max_dark;
	COLOR = vec4(0.0, 0.0, 0.0, v);
}
